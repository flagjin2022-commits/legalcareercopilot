# Copy this file to .env.local. Never commit real values.
# Required server secret.
DEEPSEEK_API_KEY=
# Optional non-secret model configuration.
DEEPSEEK_MODEL=deepseek-v4-flash

# Required server secrets for the Beta gate and internal feedback page.
# Use long, independent values. BETA_SESSION_SECRET should be at least 32 characters.
BETA_ACCESS_CODE=
BETA_ADMIN_PASSWORD=
BETA_SESSION_SECRET=

# Required on Vercel for persistent analysis snapshots and feedback.
# Keep both server-only; SUPABASE_SECRET_KEY is a Secret.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Local development only. Production never uses the serverless filesystem.
BETA_DATA_DIR=.data
# Only for local/self-hosted persistent-disk testing. Never enable on Vercel.
ALLOW_LOCAL_BETA_STORAGE=false
